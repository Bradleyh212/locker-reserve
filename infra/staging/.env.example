# Copy OUTSIDE Git, e.g. /etc/locker-staging/compose.env (0600).
RELEASE_ID=replace-with-reviewed-git-sha
WEB_DOMAIN=staging.example.com
API_DOMAIN=api-staging.example.com
ACME_EMAIL=operator@example.com
# Space-separated actual tester/operator egress IP/CIDRs. Default denies remote browsers.
STAGING_ALLOWED_CIDRS=127.0.0.1/32
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
API_CONFIG_FILE=/etc/locker-staging/api.json
DB_PASSWORD_FILE=/etc/locker-staging/db-password
PROXY_SUBNET=172.30.88.0/24
PROXY_DYNAMIC_RANGE=172.30.88.128/25
PROXY_IP=172.30.88.2
# Resolve and record immutable digests before remote deployment; check architecture.
POSTGRES_IMAGE=postgres:16-bookworm@sha256:a49f7438ba03589f9b1ca062f2da82e899b48ea1dc50d2449fa09a70be83ebca
REDIS_IMAGE=redis:7-bookworm@sha256:2e3eb11462c4e3759e6972678dd051d150ff54b1e60714b3c33b701260172a90
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
