# Copy to services/api/.env. Local development only; never commit real secrets.
# Choose your local admin email and generate a bcrypt password hash (see README).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Generate a random secret (see README).
JWT_SECRET=

# Matches infra/local/docker-compose.yml on the development computer.
DATABASE_URL=postgresql://locker:locker@localhost:5433/locker?schema=public
PORT=3001
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Use the secret test key from the same Stripe environment as the frontend key.
STRIPE_SECRET_KEY=
# Use the whsec_ value printed by your local Stripe CLI listener.
STRIPE_WEBHOOK_SECRET=

# Device bench: disabled until pulse ceiling is validated for the lock.
# Temporary absolute software ceiling: 5000 ms; 0 keeps activation disabled.
DEVICE_MAX_PULSE_MS=0
# Optional HTTPS listener for ESP32 (server certificate SAN must match its URL).
DEVICE_TLS_KEY=
DEVICE_TLS_CERT=
DEVICE_TLS_PORT=3443

# Firmware OTA stays disabled until explicitly enabled and a private release directory is configured.
OTA_ENABLED=false
FIRMWARE_RELEASE_DIR=
OTA_MAX_IMAGE_BYTES=1310720
OTA_UPDATE_TTL_MS=600000
OTA_DELIVERED_GRACE_MS=300000
