# Copy to services/api/.env. Local development only; never commit real secrets.
# Choose your local admin email and generate a bcrypt password hash (see README).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Generate a random secret (see README).
JWT_SECRET=

# Matches infra/local/docker-compose.yml on the development computer.
DATABASE_URL=postgresql://locker:locker@localhost:5433/locker?schema=public
PORT=3001
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Use the secret test key from the same Stripe environment as the frontend key.
STRIPE_SECRET_KEY=
# Use the whsec_ value printed by your local Stripe CLI listener.
STRIPE_WEBHOOK_SECRET=
