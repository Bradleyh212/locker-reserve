generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  HOLD
  CONFIRMED
  EXPIRED
  CANCELLED
}

model Locker {
  id        String   @id @default(uuid())
  code      String   @unique
  location  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  device LockerDevice?
}

model Reservation {
  id        String            @id @default(uuid())
  lockerId  String
  locker    Locker            @relation(fields: [lockerId], references: [id])
  status    ReservationStatus @default(HOLD)

  startTime DateTime
  endTime   DateTime
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  access CustomerReservationAccess?

  @@index([lockerId, startTime, endTime])
  @@index([status, expiresAt])
}

// Same credential/grant fields as customer-unlock; booking adds durable retry/payment state.
model CustomerReservationAccess {
  reservationId String @id
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  paymentIntentId String? @unique
  paidAt DateTime?
  revokedAt DateTime?
  requestKey String? @unique
  expectedAmount Int
  currency String @default("cad")
  paymentState String @default("UNPAID")
  reconciliationReason String?
  checkedAt DateTime?
  @@index([paymentState])
}

model PaymentEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  reversedIntentId String?
  outcome String?
  reservationId String?
  paymentIntentId String?
  @@index([reversedIntentId])
  createdAt     DateTime @default(now())
}

// One bench controller per locker. Credentials are stored only as SHA-256 hashes.
model LockerDevice {
  id String @id
  lockerId String @unique
  locker Locker @relation(fields: [lockerId], references: [id])
  tokenHash String @unique
  enabled Boolean @default(true)
  lastSeen DateTime?
  doorObservedAt DateTime?
  doorState String @default("UNKNOWN")
  outputState String @default("INACTIVE")
  firmwareVersion String @default("unknown")
  actuationEnabled Boolean @default(false)
  maxPulseMs Int @default(0)
  commands DeviceCommand[]
  commandReconciliations DeviceCommandReconciliation[]
  health DeviceHealth?
  events DeviceEvent[]
}

model DeviceCommand {
  id String @id @default(uuid())
  deviceId String
  device LockerDevice @relation(fields: [deviceId], references: [id])
  lockerId String
  requestedBy String
  reason String
  pulseMs Int
  issuedAt DateTime @default(now())
  expiresAt DateTime
  result String?
  resultReason String?
  completedAt DateTime?
  deliveredAt DateTime?
  expiryObservedAt DateTime?
  reconciliation DeviceCommandReconciliation?
  @@index([deviceId, issuedAt])
}

// Latest authenticated diagnostics; device uptime is not wall-clock time.
model DeviceHealth {
  deviceId String @id
  device LockerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  offline Boolean @default(false)
  bootId String?
  uptimeMs Float?
  resetReason String?
  bootObservedAt DateTime?
  wifiDisconnects Int @default(0)
  communicationFailures Int @default(0)
  updatedAt DateTime @updatedAt
}

model DeviceEvent {
  id String @id @default(uuid())
  deviceId String?
  device LockerDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type String
  severity String
  timestamp DateTime @default(now())
  commandId String?
  uptimeMs Float?
  resetReason String?
  details Json?
  dedupeKey String @unique
  occurrences Int @default(1)
  @@index([deviceId, timestamp, id])
  @@index([timestamp])
}

// An operator acknowledges uncertainty; this is never device execution proof.
model DeviceCommandReconciliation {
  commandId String @id
  command DeviceCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  deviceId String
  device LockerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  operatorId String
  acknowledgedAt DateTime @default(now())
  reason String
  evidence String
  physicalSafetyConfirmed Boolean
  originalResult String?
  originalResultReason String?
  originalCompletedAt DateTime?
  @@index([deviceId, acknowledgedAt])
}
