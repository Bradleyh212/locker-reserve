generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  HOLD
  CONFIRMED
  EXPIRED
  CANCELLED
}

model Locker {
  id        String   @id @default(uuid())
  code      String   @unique
  location  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  device LockerDevice?
}

model Reservation {
  id        String            @id @default(uuid())
  lockerId  String
  locker    Locker            @relation(fields: [lockerId], references: [id])
  status    ReservationStatus @default(HOLD)

  startTime DateTime
  endTime   DateTime
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lockerId, startTime, endTime])
  @@index([status, expiresAt])
}

model PaymentEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  createdAt     DateTime @default(now())
}

// One bench controller per locker. Credentials are stored only as SHA-256 hashes.
model LockerDevice {
  id String @id
  lockerId String @unique
  locker Locker @relation(fields: [lockerId], references: [id])
  tokenHash String @unique
  enabled Boolean @default(true)
  lastSeen DateTime?
  doorState String @default("UNKNOWN")
  outputState String @default("INACTIVE")
  firmwareVersion String @default("unknown")
  actuationEnabled Boolean @default(false)
  maxPulseMs Int @default(0)
  commands DeviceCommand[]
  firmwareReleases FirmwareRelease[]
  firmwareUpdates FirmwareUpdate[]
}

model DeviceCommand {
  id String @id @default(uuid())
  deviceId String
  device LockerDevice @relation(fields: [deviceId], references: [id])
  lockerId String
  requestedBy String
  reason String
  pulseMs Int
  issuedAt DateTime @default(now())
  expiresAt DateTime
  result String?
  resultReason String?
  completedAt DateTime?
  @@index([deviceId, issuedAt])
}

model FirmwareRelease {
  id String @id @default(uuid())
  deviceId String
  device LockerDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  version String
  buildNumber Int
  sha256 String @db.Char(64)
  sizeBytes Int
  fileName String
  notes String?
  createdAt DateTime @default(now())
  updates FirmwareUpdate[]

  @@unique([deviceId, version])
  @@unique([deviceId, buildNumber])
  @@index([deviceId, createdAt])
}

model FirmwareUpdate {
  id String @id @default(uuid())
  deviceId String
  device LockerDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  releaseId String
  release FirmwareRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedBy String
  reason String
  issuedAt DateTime @default(now())
  expiresAt DateTime
  deliveredAt DateTime?
  result String?
  resultReason String?
  reportedFirmwareVersion String?
  completedAt DateTime?

  @@index([deviceId, issuedAt])
}
